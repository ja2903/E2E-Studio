# Copy to .env.local and fill in. Never commit real values.
# Where "Book a free call" form submissions are emailed.
CONTACT_EMAIL=you@example.com
# Public site address (used for share images and links).
NEXT_PUBLIC_SITE_URL=https://e2estudio.co.uk
# Resend (resend.com) API key, used to send the booking emails. Server-only.
RESEND_API_KEY=re_xxxxxxxx
# Optional sender. Leave blank to use Resend's test sender until your domain is verified.
MAIL_FROM=
